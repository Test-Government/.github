{
  "packages": {
    "opentofu":  "latest",
    "jq":        "latest",
    "keepassxc": "latest",
    "gitleaks":  "latest"
  },
  "shell": {
    "scripts": {
      "github-tofu": ["sh scripts/github-tf.sh \"$@\""],
      "ci": [
        "devbox run validate",
        "sh -n scripts/github-tf.sh",
        "sh -n scripts/github-app.sh",
        "gitleaks git --redact --no-banner ."
      ],
      "validate": [
        "tofu -chdir=tofu/github init -backend=false -input=false",
        "tofu -chdir=tofu/github validate",
        "tofu -chdir=tofu/github fmt -check -diff"
      ]
    }
  }
}
