{
  "packages": {
    "opentofu":   "latest",
    "jq":         "latest",
    "keepassxc":  "latest",
    "gitleaks":   "latest",
    "shellcheck": "latest",
    "actionlint": "latest"
  },
  "shell": {
    "scripts": {
      "github-tofu": ["sh scripts/github-tf.sh \"$@\""],
      "follow-ups-lint": ["sh scripts/follow-ups-lint.sh"],
      "ci": [
        "devbox run validate",
        "shellcheck scripts/*.sh .claude/hooks/*.sh",
        "actionlint .github/workflows/*.yml templates/ci-caller.yml",
        "sh scripts/follow-ups-lint.sh",
        "gitleaks git --redact --no-banner ."
      ],
      "validate": [
        "tofu -chdir=tofu/github init -backend=false -input=false",
        "tofu -chdir=tofu/github validate",
        "tofu -chdir=tofu/github fmt -check -diff"
      ]
    }
  }
}
